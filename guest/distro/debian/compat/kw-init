# unkernel x86-64 compatibility suite (test asset). It prints only
# deterministic lines, so the same rootfs can run in a native chroot and
# under kwemu and the two logs diffed. See README.md.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL
exec 2>&1
cd /tmp || exit 1
rm -rf /tmp/cmp && mkdir /tmp/cmp && cd /tmp/cmp || exit 1
echo COMPAT-START

echo "md5=$(printf hello | md5sum | cut -d' ' -f1)"
echo "sha=$(printf hello | sha256sum | cut -d' ' -f1)"
echo "wc=$(printf 'a\nb\nc\n' | wc -l):$(printf 'a\nb\nc\n' | wc -c)"
echo "dd=$(dd if=/dev/zero bs=65536 count=512 2>/dev/null | wc -c)"
echo "arith=$(( (1<<40) / 7 )) $(( 1234567890123 % 1000000007 ))"
echo "seq=$(seq 1 100000 | sort -nr | head -1)"
echo "awk=$(seq 1 200000 | awk '{s+=$1} END {printf "%.0f", s}')"
echo "sed=$(seq 1 10000 | sed -n '9999p')"
echo "tr=$(printf 'a,b,c' | tr ',' '\n' | wc -l)"
echo "base64=$(printf unkernel | base64 | base64 -d)"

mkdir -p t1/t2
for i in 1 2 3 4 5; do seq 1 1000 | awk -v i=$i '{print i*$1}' > t1/t2/f$i; done
echo "tar=$(tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -C t1 -cf - t2 | md5sum | cut -d' ' -f1)"
tar -C t1 -cf a.tar t2 && mkdir -p t3 && tar -C t3 -xf a.tar && diff -r t1/t2 t3/t2 && echo "tar_rt=ok"
echo "gzip=$(gzip -9nc t1/t2/f1 | md5sum | cut -d' ' -f1)"
gzip -9nc t1/t2/f1 > f1.gz && gzip -dc f1.gz | cmp - t1/t2/f1 && echo "gzip_rt=ok"

touch f && chmod 640 f
echo "mode=$(stat -c %a f)"
ln -s f l
echo "link=$(readlink l)"
mkdir -p d/e/f && echo "dirs=$(find d -type d | wc -l)"
mv f g && rm -rf d l g
timeout 1 sleep 3
echo "timeout=$?"

echo "basharr=$(bash -c 'a=(3 1 2); IFS=,; echo "${a[*]}"')"
echo "bashpipe=$(bash -c 'set -o pipefail; false | true; echo $?')"
echo "bashjob=$(bash -c 'sleep 0.1 & p=$!; wait $p; echo $?')"
echo "bashfn=$(bash -c 'f(){ echo $(($1*$1)); }; s=0; for i in $(seq 1 2000); do s=$((s+$(f $i))); done; echo $s')"

echo "perl=$(perl -e 'my $s=0; $s+=$_ for 1..1000000; print $s')"
echo "perl64=$(perl -e 'my $x=3; $x*=3 for 1..40; printf "%.0f", $x')"
echo "perlstr=$(perl -e 'my $s="x" x 5000000; print length($s)')"
echo "perlsort=$(perl -e 'my @a=map {($_*2654435761)&0xffffffff} 1..100000; @a=sort {$a<=>$b} @a; print "$a[0],$a[50000],$a[-1]"')"
echo "perlfp=$(perl -e 'my $s=0; $s+=1/$_ for 1..200000; printf "%.15g", $s')"
echo "perlfmt=$(perl -e 'printf "%.17g %.17g %.17g", 0.1+0.2, 1/3, 1e300*1e30')"
echo "perlsig=$(perl -e '$SIG{ALRM}=sub{print "alarm"; exit 0}; alarm 1; select undef,undef,undef,3')"
echo "perlfork=$(perl -e 'my $n=0; for (1..20) { my $p=fork(); if(!$p){exit 7} waitpid($p,0); $n++ if ($?>>8)==7 } print $n')"
echo "perlpipe=$(perl -e 'pipe(R,W); my $p=fork(); if(!$p){close R; print W "hi\n"; exit 0} close W; my $l=<R>; waitpid($p,0); print $l')"
echo "perlre=$(perl -e 'my $s=("abc123" x 100000); my $n=()=$s=~/[0-9]+/g; print $n')"
echo "perlmem=$(perl -e 'my @a=(1)x4000000; print scalar(@a)')"

for g in inttest fptest sse2test strtest; do
	echo "$g=$(/opt/compat/$g.elf | md5sum | cut -d' ' -f1)"
done

echo "COMPAT-DONE"
[ -n "$KW_NOPOWER" ] || exec /run/kw-lower/bin/busybox poweroff -f
