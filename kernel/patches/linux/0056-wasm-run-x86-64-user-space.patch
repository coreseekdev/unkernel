 arch/wasm/Makefile                      |  12 +-
 arch/wasm/configs/kw_x86.config         |   3 +
 arch/wasm/include/asm/elf.h             |  29 ++-
 arch/wasm/include/asm/kw_emu.h          |  83 +++++--
 arch/wasm/include/asm/processor.h       |  10 +
 arch/wasm/include/asm/ptrace.h          |  37 ++-
 arch/wasm/include/asm/seccomp.h         |  11 +-
 arch/wasm/include/asm/stat.h            |  50 ++++
 arch/wasm/include/asm/syscall.h         |  65 ++++-
 arch/wasm/include/asm/syscall_wrapper.h |   7 +
 arch/wasm/include/asm/unistd.h          |  14 ++
 arch/wasm/include/uapi/asm/fcntl.h      |   9 +
 arch/wasm/include/uapi/asm/prctl.h      |  14 ++
 arch/wasm/kernel/Makefile.syscalls      |  11 +-
 arch/wasm/kernel/cpu.c                  |  35 +++
 arch/wasm/kernel/process.c              |  37 ++-
 arch/wasm/kernel/prof.c                 |   8 +-
 arch/wasm/kernel/ptrace.c               |  31 +++
 arch/wasm/kernel/signal.c               | 317 ++++++++++++++++++++++++
 arch/wasm/kernel/sys.c                  |  56 +++++
 arch/wasm/kernel/syscall_table.c        |   9 +-
 arch/wasm/kernel/traps.c                |  44 +++-
 arch/wasm/mm/fault.c                    |   6 +-
 arch/wasm/mm/sigpage.c                  |   7 +
 25 files changed, 878 insertions(+), 53 deletions(-)
