+/*
+ * x86-64's per-thread segment bases. There is no hardware to program: the
+ * bases live in the user context kwemu runs, so the syscall changes them
+ * directly.
+ */
+SYSCALL_DEFINE2(arch_prctl, int, code, unsigned long, addr)
+{
+	struct pt_regs *regs = current_pt_regs();
+
+	switch (code) {
+	case ARCH_SET_FS:
+		regs->user.fs_base = addr;
+		return 0;
+	case ARCH_SET_GS:
+		regs->user.gs_base = addr;
+		return 0;
+	case ARCH_GET_FS:
+		return put_user(regs->user.fs_base,
+				(unsigned long __user *)addr) ? -EFAULT : 0;
+	case ARCH_GET_GS:
+		return put_user(regs->user.gs_base,
+				(unsigned long __user *)addr) ? -EFAULT : 0;
+	case ARCH_GET_CPUID:
+		return 0;
+	case ARCH_SET_CPUID:
+		return -ENODEV;
+	default:
+		return -EINVAL;
+	}
+}
