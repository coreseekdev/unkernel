diff --git a/arch/wasm/Kconfig b/arch/wasm/Kconfig
index ec1eda88f..7114e5e10 100644
--- a/arch/wasm/Kconfig
+++ b/arch/wasm/Kconfig
@@ -2,6 +2,21 @@
 
 menu "Wasm-specific options"
 
+choice
+	prompt "User-mode ABI"
+	default WASM_USER_AARCH64
+	help
+	  The Linux user ABI kwemu presents. The kernel, its page tables and
+	  devices are the same; the guest CPU, the syscall table, the signal
+	  frames and the ptrace layouts follow this choice.
+
+config WASM_USER_AARCH64
+	bool "AArch64 (arm64)"
+
+config WASM_USER_X86_64
+	bool "x86-64"
+endchoice
+
 #
 # Execution model (unkernel): the kernel is a single Wasm instance running
 # on one host thread. Kernel tasks are separate Wasm stacks switched with JSPI
@@ -16,13 +31,12 @@ config WASM
 	default y
 	select ARCH_NO_PREEMPT
 	# arm64 user ABI: clone(flags, newsp, ptid, tls, ctid), as on arm64.
-	# arm64's other ABI selects are for compat (AArch32) or BTI/GNU
-	# property notes, which this port does not have.
-	select CLONE_BACKWARDS
-	# seccomp filters see AUDIT_ARCH_AARCH64 and arm64's syscall numbers.
+	# x86-64 uses the mainline order (flags, newsp, ptid, ctid, tls).
+	select CLONE_BACKWARDS if WASM_USER_AARCH64
+	# seccomp filters see AUDIT_ARCH_AARCH64 or AUDIT_ARCH_X86_64.
 	select HAVE_ARCH_SECCOMP_FILTER
-	# ptrace's regsets (arm64's), PTRACE_GET_SYSCALL_INFO, /proc/PID/syscall
-	select HAVE_ARCH_TRACEHOOK
+	# ptrace's arm64 regsets; x86-64 brings its own up later.
+	select HAVE_ARCH_TRACEHOOK if WASM_USER_AARCH64
 	select HAVE_VIRT_CPU_ACCOUNTING_GEN
 	select HAVE_CONTEXT_TRACKING_USER
 
diff --git a/arch/wasm/Makefile b/arch/wasm/Makefile
index 8512b7e3c..1b2fd3352 100644
--- a/arch/wasm/Makefile
+++ b/arch/wasm/Makefile
@@ -2,8 +2,16 @@
 
 KBUILD_DEFCONFIG := kw_defconfig
 
-# User mode is arm64.
-UTS_MACHINE := aarch64
+# User mode: arm64 by default, x86-64 with CONFIG_WASM_USER_X86_64.
+UTS_MACHINE := $(if $(CONFIG_WASM_USER_X86_64),x86_64,aarch64)
+# The header-generation sub-make (scripts/Makefile.asm-headers) does not
+# inherit auto.conf's variables unless they are exported; it chooses the
+# syscall table from this one.
+export CONFIG_WASM_USER_X86_64
+
+ifeq ($(CONFIG_WASM_USER_X86_64),y)
+KBUILD_CFLAGS += -DKW_USER_ISA_X86_64
+endif
 
 KCFLAGS += -nostdlib -fno-builtin
 KCFLAGS += -march=wasm64
diff --git a/arch/wasm/configs/kw_x86.config b/arch/wasm/configs/kw_x86.config
new file mode 100644
index 000000000..04b6aa19a
--- /dev/null
+++ b/arch/wasm/configs/kw_x86.config
@@ -0,0 +1,3 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# x86-64 user mode (kernel/build.sh KW_USER_ISA=x86_64).
+CONFIG_WASM_USER_X86_64=y
diff --git a/arch/wasm/include/asm/elf.h b/arch/wasm/include/asm/elf.h
index fc3631e5a..afb978c5c 100644
--- a/arch/wasm/include/asm/elf.h
+++ b/arch/wasm/include/asm/elf.h
@@ -4,8 +4,10 @@
 #define _ASM_WASM_ELF_H
 
 /*
- * User mode is arm64 (AArch64, little-endian, LP64): this mirrors
- * arch/arm64/include/asm/elf.h without compat (AArch32) and without a vDSO.
+ * User mode is arm64 (AArch64, little-endian, LP64) by default, mirroring
+ * arch/arm64/include/asm/elf.h without compat (AArch32) and without a vDSO;
+ * CONFIG_WASM_USER_X86_64 presents the x86-64 ELF ABI instead
+ * (arch/x86/include/asm/elf.h, without compat or a vDSO).
  */
 
 #include <uapi/linux/elf.h>
@@ -16,25 +18,42 @@
 
 typedef unsigned long elf_greg_t;
 
+#ifdef CONFIG_WASM_USER_X86_64
+#define ELF_NGREG	27
+typedef elf_greg_t elf_gregset_t[ELF_NGREG];
+typedef struct { u32 cwd, swd, twd, fop, fip, fcs, foo, fos; u8 st[80]; u32 mxcsr, mxcsr_mask; u8 xmm[256]; } elf_fpregset_t;
+
+#define ELF_ARCH	EM_X86_64
+#else
 #define ELF_NGREG (sizeof(struct user_pt_regs) / sizeof(elf_greg_t))
 typedef elf_greg_t elf_gregset_t[ELF_NGREG];
 typedef struct user_fpsimd_state elf_fpregset_t;
 
 #define ELF_ARCH	EM_AARCH64
+#endif
 #define ELF_CLASS	ELFCLASS64
 #define ELF_DATA	ELFDATA2LSB
 
+#ifdef CONFIG_WASM_USER_X86_64
+#define elf_check_arch(x) (((x)->e_machine == EM_X86_64) && \
+			   ((x)->e_ident[EI_CLASS] == ELF_CLASS))
+#else
 #define elf_check_arch(x) (((x)->e_machine == EM_AARCH64) && \
 			   ((x)->e_ident[EI_CLASS] == ELF_CLASS))
+#endif
 
 #define ELF_EXEC_PAGESIZE	(PAGE_SIZE)
 #define ELF_ET_DYN_BASE		((DEFAULT_MAP_WINDOW / 3) * 2)
 #define STACK_RND_MASK		(0x3ffff >> (PAGE_SHIFT - 12))
 
 #define ELF_PLATFORM_SIZE	16
+#ifdef CONFIG_WASM_USER_X86_64
+#define ELF_PLATFORM		("x86_64")
+#else
 #define ELF_PLATFORM		("aarch64")
+#endif
 
-/* cpu.c: FP, ASIMD and what kw_set_isa() enabled; nothing in HWCAP2/3. */
+/* cpu.c: arm64 HWCAP, or x86-64's CPUID features in EDX form. */
 #define ELF_HWCAP		(kw_elf_hwcap)
 #define ELF_HWCAP2		(0UL)
 #define ELF_HWCAP3		(0UL)
@@ -52,6 +71,7 @@ struct linux_binprm;
 extern int arch_setup_additional_pages(struct linux_binprm *bprm,
 				       int uses_interp);
 
+#ifdef CONFIG_WASM_USER_AARCH64
 /* Core dump notes come from the ptrace regsets (ptrace.c), as on arm64. */
 #define CORE_DUMP_USE_REGSET
 
@@ -64,6 +84,9 @@ do {									\
 	__d->pc = (regs)->user.pc;					\
 	__d->pstate = (regs)->user.nzcv;				\
 } while (0);
+#else
+/* x86-64 core dumps wait for its regsets; the generic notes are enough. */
+#endif
 
 #define SET_PERSONALITY(ex) \
 	set_personality(PER_LINUX | (current->personality & (~PER_MASK)))
diff --git a/arch/wasm/include/asm/kw_emu.h b/arch/wasm/include/asm/kw_emu.h
index 7db679113..5fa10fe0a 100644
--- a/arch/wasm/include/asm/kw_emu.h
+++ b/arch/wasm/include/asm/kw_emu.h
@@ -7,13 +7,15 @@
  * guest registers in a kernel-owned struct kw_regs (normally inside the
  * task's pt_regs).
  *
- * Guest ISA: AArch64, A64 instruction set, ARMv8.0-A user mode (EL0),
- * little-endian, with FP and AdvSIMD. No SVE, pointer authentication or
- * MTE; the PAC and BTI encodings in the hint space run as NOPs. The crypto
- * extensions, LSE atomics, SHA-512 and SHA-3 are optional features
- * (KW_ISA_*, below), enabled only when this build implements them.
- * .agents/a64.md lists which instructions are implemented; every other
- * encoding raises KW_EV_ILLEGAL.
+ * Guest ISA: selected at build time. By default AArch64, A64 instruction
+ * set, ARMv8.0-A user mode (EL0), little-endian, with FP and AdvSIMD. No
+ * SVE, pointer authentication or MTE; the PAC and BTI encodings in the
+ * hint space run as NOPs. The crypto extensions, LSE atomics, SHA-512 and
+ * SHA-3 are optional features (KW_ISA_*, below), enabled only when this
+ * build implements them. A build with KW_USER_ISA_X86_64 has an x86-64
+ * user mode instead (the integer baseline and SSE2; see src/x86_64 and
+ * HANDOFF.md), using the x86-64 struct kw_regs below. Every other encoding
+ * raises KW_EV_ILLEGAL.
  *
  * Memory model: kernel and emulator share one wasm64 linear memory. A
  * "physical address" is a linear-memory address minus cpu->phys_base.
@@ -80,8 +82,16 @@
 extern "C" {
 #endif
 
-#define KW_ABI_VERSION 4
+#define KW_ABI_VERSION 5
 
+/*
+ * The register state of one task depends on the guest ISA the emulator was
+ * built for (the build-time KW_USER_ISA, compile-time selected here with
+ * KW_USER_ISA_X86_64). Both layouts are fixed; a kernel bundle and a
+ * kwemu build of the same ISA use the one below, and a bundle never mixes
+ * them.
+ */
+#ifndef KW_USER_ISA_X86_64
 /*
  * A64 register state of one task. Fixed layout (offsets in bytes): x[0..30]
  * at 0, sp 248, pc 256, nzcv 264, fpcr 268, fpsr 272, tpidr_el0 280, and
@@ -102,20 +112,59 @@ struct kw_regs {
 	uint64_t tpidr_el0;
 	uint64_t v[32][2] __attribute__((aligned(16)));
 } __attribute__((aligned(16)));
+#else
+/*
+ * x86-64 register state of one task. The first 27 words are Linux's
+ * `struct user_regs_struct` in its order (ptrace can expose them as is):
+ * r15 r14 r13 r12 rbp rbx r11 r10 r9 r8 rax rcx rdx rsi rdi orig_rax rip
+ * cs eflags rsp ss fs_base gs_base ds es fs gs. `rip` is the pc and the
+ * event's with-register state; `eflags` holds the architectural RFLAGS
+ * (bit 1 reads as 1). fs_base/gs_base are the segment bases TLS uses; the
+ * ds/es/fs/gs selectors are kept only because user_regs_struct has them.
+ * Then mxcsr and the 16 128-bit XMM registers (16-byte aligned, the memory
+ * image of a little-endian __uint128_t).
+ */
+struct kw_regs {
+	uint64_t r15, r14, r13, r12, rbp, rbx;
+	uint64_t r11, r10, r9, r8;
+	uint64_t rax, rcx, rdx, rsi, rdi;
+	uint64_t orig_rax, rip, cs, eflags, rsp, ss;
+	uint64_t fs_base, gs_base, ds, es, fs, gs;
+	uint32_t mxcsr;    /* MXCSR as LDMXCSR/STMXCSR see it */
+	uint32_t _pad;
+	uint64_t xmm[16][2] __attribute__((aligned(16)));
+	/* x87 ST(0)..ST(7) in physical order (fsw bits 11..13 hold TOP); the
+	 * 80-bit value is the low 10 bytes of each slot. Then the control,
+	 * status and tag words. */
+	uint64_t x87[8][2] __attribute__((aligned(16)));
+	uint16_t fcw, fsw, ftw, fop;
+	uint64_t fip, fdp;
+} __attribute__((aligned(16)));
+#endif
 
 enum kw_event_kind {
 	KW_EV_BUDGET = 0,      /* instruction budget used up (timer tick point) */
-	KW_EV_SYSCALL = 1,     /* SVC #imm (any imm); pc already past it; the
-				  number is in x8, the arguments in x0..x5 */
+	KW_EV_SYSCALL = 1,     /* SVC #imm (any imm), or SYSCALL on x86-64;
+				  pc already past it; A64: number in x8,
+				  arguments in x0..x5; x86-64: number in
+				  rax, arguments in rdi rsi rdx r10 r8 r9,
+				  rcx/r11 already hold the return rip and
+				  flags */
 	KW_EV_FAULT = 2,       /* page fault; pc at the faulting instruction */
 	KW_EV_ILLEGAL = 3,     /* unallocated or unimplemented encoding, UDF,
 				  HLT, HVC, SMC, a system register EL0 may not
-				  access; pc at it, ev.insn = the raw word */
-	KW_EV_BREAKPOINT = 4,  /* BRK #imm; pc at it, ev.insn = the raw word */
-	KW_EV_MISALIGNED = 5,  /* pc not 4-byte aligned (ev.addr = pc), or an
+				  access (x86-64: #UD, e.g. x87 or an
+				  unadvertised extension); pc at it,
+				  ev.insn = the raw word (first bytes on
+				  x86-64) */
+	KW_EV_BREAKPOINT = 4,  /* BRK #imm, or INT3 on x86-64; pc at it,
+				  ev.insn = the raw word */
+	KW_EV_MISALIGNED = 5,  /* pc not 4-byte aligned (ev.addr = pc), an
 				  exclusive or acquire/release access that is
-				  not naturally aligned (ev.addr = the
-				  address); pc at the instruction */
+				  not naturally aligned, or an x86-64 aligned
+				  SSE access on an unaligned address
+				  (ev.addr = the address); pc at the
+				  instruction */
 	KW_EV_INTERRUPT = 6,   /* *cpu->irq_pending became non-zero */
 };
 
@@ -172,7 +221,9 @@ void kw_cpu_init(struct kw_cpu *cpu);
  * taken branch out of a block (a branch the decoder followed
  * inside a page is not a check point). Every event leaves regs (incl. pc)
  * exactly at an instruction boundary. Data accesses may be unaligned
- * (SCTLR_EL1.A = 0); SP alignment is not checked.
+ * (SCTLR_EL1.A = 0); SP alignment is not checked. x86-64: instruction
+ * fetch requires an executable mapping, and an aligned SSE access on an
+ * unaligned address is KW_EV_MISALIGNED.
  */
 uint32_t kw_run(struct kw_cpu *cpu, struct kw_regs *regs);
 
diff --git a/arch/wasm/include/asm/processor.h b/arch/wasm/include/asm/processor.h
index 037570583..49afcca46 100644
--- a/arch/wasm/include/asm/processor.h
+++ b/arch/wasm/include/asm/processor.h
@@ -16,7 +16,12 @@
  * numerically; they are different address spaces (user memory is only
  * reachable through page-table walks).
  */
+#ifdef CONFIG_WASM_USER_X86_64
+/* x86-64 canonical user addresses: 47 bits, as on Linux x86-64. */
+#define TASK_SIZE		(_AC(1, UL) << 47)
+#else
 #define TASK_SIZE		(_AC(1, UL) << 48)
+#endif
 #define TASK_SIZE_MAX		TASK_SIZE
 #define DEFAULT_MAP_WINDOW	TASK_SIZE
 #define STACK_TOP		TASK_SIZE
@@ -83,8 +88,13 @@ static inline unsigned long __get_wchan(struct task_struct *p)
 #define task_pt_regs(task) \
 	((struct pt_regs *)(task_stack_page(task) + THREAD_SIZE) - 1)
 
+#ifdef CONFIG_WASM_USER_X86_64
+#define KSTK_EIP(tsk)	(task_pt_regs(tsk)->user.rip)
+#define KSTK_ESP(tsk)	(task_pt_regs(tsk)->user.rsp)
+#else
 #define KSTK_EIP(tsk)	(task_pt_regs(tsk)->user.pc)
 #define KSTK_ESP(tsk)	(task_pt_regs(tsk)->user.sp)
+#endif
 
 #endif /* __ASSEMBLER__ */
 
diff --git a/arch/wasm/include/asm/ptrace.h b/arch/wasm/include/asm/ptrace.h
index 1e8b9a762..481adfb23 100644
--- a/arch/wasm/include/asm/ptrace.h
+++ b/arch/wasm/include/asm/ptrace.h
@@ -11,8 +11,10 @@
 
 /*
  * Kernel entry frame. For user tasks it sits at the top of the kernel stack
- * and holds the arm64 user context run by kwemu. Frames for interrupts
- * taken while in the kernel (idle) are built on the stack with kernel=1.
+ * and holds the user context run by kwemu (arm64 or x86-64, selected at
+ * build time; the layout of `user` is include/kw_emu.h's). Frames for
+ * interrupts taken while in the kernel (idle) are built on the stack with
+ * kernel=1.
  */
 struct pt_regs {
 	struct kw_regs user;	/* x0..x30, sp, pc, nzcv, fpcr, fpsr, tpidr_el0, v0..v31 */
@@ -25,7 +27,11 @@ struct pt_regs {
 };
 
 #define PT_CAUSE_NONE		(-1UL)
+#ifdef CONFIG_WASM_USER_X86_64
+#define PT_CAUSE_SYSCALL	0x200UL	/* a marker, not an exception class */
+#else
 #define PT_CAUSE_SYSCALL	0x15UL	/* like arm64 ESR_ELx_EC_SVC64 */
+#endif
 
 /* syscall_get_nr() outside a syscall; also the syscall a tracer skips. */
 #define NO_SYSCALL		(-1)
@@ -35,6 +41,32 @@ struct pt_regs {
 #define KW_FPSR_MASK	((1U << 27) | (1U << 7) | 0x1fU)
 
 #define user_mode(regs)			(!(regs)->kernel)
+
+#ifdef CONFIG_WASM_USER_X86_64
+#define instruction_pointer(regs)	((regs)->user.rip)
+#define user_stack_pointer(regs)	((regs)->user.rsp)
+#define profile_pc(regs)		instruction_pointer(regs)
+
+static inline void instruction_pointer_set(struct pt_regs *regs,
+					   unsigned long val)
+{
+	regs->user.rip = val;
+}
+
+static inline unsigned long regs_return_value(struct pt_regs *regs)
+{
+	return regs->user.rax;
+}
+
+static inline void regs_set_return_value(struct pt_regs *regs,
+					 unsigned long val)
+{
+	regs->user.rax = val;
+}
+
+/* x86-64 exposes no regsets yet (HAVE_ARCH_TRACEHOOK is off). */
+#define arch_has_single_step()		(0)
+#else
 #define instruction_pointer(regs)	((regs)->user.pc)
 #define user_stack_pointer(regs)	((regs)->user.sp)
 #define profile_pc(regs)		instruction_pointer(regs)
@@ -58,6 +90,7 @@ static inline void regs_set_return_value(struct pt_regs *regs,
 
 /* In software: user_mode_loop() runs one instruction per kw_run(). */
 #define arch_has_single_step()		(1)
+#endif
 
 #define current_pt_regs()		task_pt_regs(current)
 #define current_user_stack_pointer()	user_stack_pointer(current_pt_regs())
diff --git a/arch/wasm/include/asm/seccomp.h b/arch/wasm/include/asm/seccomp.h
index 184470417..35057bdf4 100644
--- a/arch/wasm/include/asm/seccomp.h
+++ b/arch/wasm/include/asm/seccomp.h
@@ -1,7 +1,8 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 /*
- * seccomp for the arm64 user ABI (as arch/arm64, without compat): filters
- * see AUDIT_ARCH_AARCH64 and arm64's syscall numbers. SECCOMP_ARCH_NATIVE
+ * seccomp for the selected user ABI (arm64 by default, x86-64 with
+ * CONFIG_WASM_USER_X86_64): filters see that arch's audit value and
+ * syscall numbers. SECCOMP_ARCH_NATIVE
  * turns on the per-filter cache of syscalls that are always allowed, so
  * those skip the BPF interpreter (the arch has no BPF JIT).
  */
@@ -10,8 +11,14 @@
 
 #include <asm-generic/seccomp.h>
 
+#ifdef CONFIG_WASM_USER_X86_64
+#define SECCOMP_ARCH_NATIVE		AUDIT_ARCH_X86_64
+#define SECCOMP_ARCH_NATIVE_NR		NR_syscalls
+#define SECCOMP_ARCH_NATIVE_NAME	"x86_64"
+#else
 #define SECCOMP_ARCH_NATIVE		AUDIT_ARCH_AARCH64
 #define SECCOMP_ARCH_NATIVE_NR		NR_syscalls
 #define SECCOMP_ARCH_NATIVE_NAME	"aarch64"
+#endif
 
 #endif /* _ASM_WASM_SECCOMP_H */
diff --git a/arch/wasm/include/asm/stat.h b/arch/wasm/include/asm/stat.h
new file mode 100644
index 000000000..712a2cfd7
--- /dev/null
+++ b/arch/wasm/include/asm/stat.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * struct stat for the guest user ABI. AArch64 (and the asm-generic layout)
+ * is the default. x86-64's newfstatat/fstat use their own struct stat (see
+ * arch/x86/include/uapi/asm/stat.h), so a CONFIG_WASM_USER_X86_64 build
+ * has to hand that layout to fs/stat.c's cp_new_stat().
+ */
+#ifndef __ASM_STAT_H
+#define __ASM_STAT_H
+
+#ifdef CONFIG_WASM_USER_X86_64
+
+#include <asm/posix_types.h>
+
+struct stat {
+	__kernel_ulong_t	st_dev;
+	__kernel_ulong_t	st_ino;
+	__kernel_ulong_t	st_nlink;
+
+	unsigned int		st_mode;
+	unsigned int		st_uid;
+	unsigned int		st_gid;
+	unsigned int		__pad0;
+	__kernel_ulong_t	st_rdev;
+	__kernel_long_t		st_size;
+	__kernel_long_t		st_blksize;
+	__kernel_long_t		st_blocks;
+
+	__kernel_ulong_t	st_atime;
+	__kernel_ulong_t	st_atime_nsec;
+	__kernel_ulong_t	st_mtime;
