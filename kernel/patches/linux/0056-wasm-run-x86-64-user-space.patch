diff --git a/arch/wasm/kernel/signal.c b/arch/wasm/kernel/signal.c
index 040dd1c65..32a8e5043 100644
--- a/arch/wasm/kernel/signal.c
+++ b/arch/wasm/kernel/signal.c
@@ -29,6 +29,8 @@
 #include <asm/kw_emu.h>
 #include <asm/kwcpu.h>
 
+#ifdef CONFIG_WASM_USER_AARCH64
+
 struct rt_sigframe {
 	struct siginfo info;
 	struct ucontext uc;
@@ -322,3 +324,318 @@ static int __init init_signal_minsigstksz(void)
 	return 0;
 }
 arch_initcall(init_signal_minsigstksz);
+
+#else /* CONFIG_WASM_USER_X86_64 */
+
+/*
+ * x86-64's rt_sigframe (arch/x86/kernel/signal_64.c, arch/x86/include/
+ * uapi/asm/sigcontext.h), without x32 and without a vDSO. The kernel's
+ * sigset_t is 8 bytes; a libc's ucontext_t has a wider sigmask, which the
+ * kernel does not touch.
+ *
+ * The frame: pretcode (the SA_RESTORER stub, required on x86-64), ucontext
+ * (with the 23 GPR words and a pointer to the FXSAVE area), then siginfo;
+ * the FXSAVE area follows the frame. The handler is entered directly with
+ * rdi = sig, rsi = &info, rdx = &ucontext and rsp = frame, so its ret goes
+ * to pretcode. There is no vDSO and no sigpage: x86-64 requires
+ * SA_RESTORER, which musl and glibc always set.
+ */
+
+#define UC_SIGCONTEXT_SS	0x2
+#define X86_EFLAGS_IF		0x200U
+#define X86_EFLAGS_TF		0x100U
+
+struct sigcontext_x86 {
+	__u64 r8, r9, r10, r11, r12, r13, r14, r15;
+	__u64 rdi, rsi, rbp, rbx, rdx, rax, rcx, rsp, rip, eflags;
+	__u16 cs, gs, fs;
+	union { __u16 ss; __u16 pad0; };
+	__u64 err, trapno, oldmask, cr2;
+	__u64 fpstate;
+	__u64 reserved1[8];
+};
+
+struct ucontext_x86 {
+	unsigned long uc_flags;
+	struct ucontext_x86 __user *uc_link;
+	stack_t uc_stack;
+	struct sigcontext_x86 uc_mcontext;
+	sigset_t uc_sigmask;
+};
+
+struct fpstate_x86 {
+	__u16 cwd, swd, twd, fop;
+	__u64 rip, rdp;
+	__u32 mxcsr, mxcsr_mask;
+	__u8 st[128];
+	__u8 xmm[256];
+	__u8 reserved[96];
+};
+
+struct rt_sigframe_x86 {
+	char __user *pretcode;
+	struct ucontext_x86 uc;
+	struct siginfo info;
+	/* struct fpstate_x86 follows here, 16-byte aligned */
+};
+
+unsigned long signal_minsigstksz __ro_after_init;
+
+static struct fpstate_x86 __user *sigframe_fp(struct rt_sigframe_x86 __user *frame)
+{
+	return (struct fpstate_x86 __user *)
+		((unsigned long)(frame + 1) + 15 & ~15UL);
+}
+
+SYSCALL_DEFINE0(rt_sigreturn)
+{
+	struct pt_regs *regs = current_pt_regs();
+	struct rt_sigframe_x86 __user *frame;
+	struct sigcontext_x86 __user *sc;
+	struct fpstate_x86 __user *fp;
+	sigset_t set;
+	__u64 g[18], fs_base, gs_base;
+	int i, err = 0;
+
+	current->restart_block.fn = do_no_restart_syscall;
+
+	if (regs->user.rsp & 7)
+		goto badframe;
+
+	/* The handler returns through pretcode (the SA_RESTORER stub), so by
+	 * the time the stub issues rt_sigreturn that word has been popped and
+	 * rsp points just past it. Linux reads the frame from rsp - 8. */
+	frame = (struct rt_sigframe_x86 __user *)(regs->user.rsp - sizeof(__u64));
+	if (!access_ok(frame, sizeof(*frame)))
+		goto badframe;
+	sc = &frame->uc.uc_mcontext;
+
+	if (__copy_from_user(&set, &frame->uc.uc_sigmask, sizeof(set)))
+		goto badframe;
+	set_current_blocked(&set);
+
+	/* sigcontext order: r8..r15, rdi, rsi, rbp, rbx, rdx, rax, rcx,
+	 * rsp, rip, eflags (kw_regs stores the GPRs in another order). */
+	err |= __copy_from_user(g, &sc->r8, sizeof(g));
+	err |= __get_user(fs_base, &sc->reserved1[0]);
+	err |= __get_user(gs_base, &sc->reserved1[1]);
+	if (err)
+		goto badframe;
+	regs->user.r8 = g[0];
+	regs->user.r9 = g[1];
+	regs->user.r10 = g[2];
+	regs->user.r11 = g[3];
+	regs->user.r12 = g[4];
+	regs->user.r13 = g[5];
+	regs->user.r14 = g[6];
+	regs->user.r15 = g[7];
+	regs->user.rdi = g[8];
+	regs->user.rsi = g[9];
+	regs->user.rbp = g[10];
+	regs->user.rbx = g[11];
+	regs->user.rdx = g[12];
+	regs->user.rax = g[13];
+	regs->user.rcx = g[14];
+	regs->user.rsp = g[15];
+	regs->user.rip = g[16];
+	regs->user.eflags = g[17];
+	if (regs->user.eflags & X86_EFLAGS_TF)
+		goto badframe;
+
+	regs->user.cs = 0x33;
+	regs->user.ss = 0x2b;
+	regs->user.fs_base = fs_base;
+	regs->user.gs_base = gs_base;
+	/* The saved fs/gs selectors are always the flat user ones here. */
+
+	fp = sigframe_fp(frame);
+	if (__copy_from_user(&regs->user.mxcsr, &fp->mxcsr, sizeof(u32)))
+		goto badframe;
+	if (__get_user(regs->user.fcw, &fp->cwd) ||
+	    __get_user(regs->user.fsw, &fp->swd) ||
+	    __get_user(regs->user.ftw, &fp->twd) ||
+	    __get_user(regs->user.fop, &fp->fop))
+		goto badframe;
+	for (i = 0; i < 8; i++)
+		err |= __copy_from_user(&regs->user.x87[i], &fp->st[i * 16], 16);
+	for (i = 0; i < 16; i++)
+		err |= __copy_from_user(&regs->user.xmm[i], &fp->xmm[i * 16], 16);
+	if (err || restore_altstack(&frame->uc.uc_stack))
+		goto badframe;
+
+	regs->cause = PT_CAUSE_NONE;
+	return regs->user.rax;
+
+badframe:
+	if (show_unhandled_signals)
+		pr_info_ratelimited("%s[%d]: bad frame in %s: frame=%p rip=%llx rsp=%llx\n",
+				    current->comm, task_pid_nr(current), __func__,
+				    frame, instruction_pointer(regs),
+				    user_stack_pointer(regs));
+	force_sig(SIGSEGV);
+	return 0;
+}
+
+static int setup_sigframe(struct rt_sigframe_x86 __user *frame,
+			  struct pt_regs *regs, sigset_t *set)
+{
+	struct sigcontext_x86 __user *sc = &frame->uc.uc_mcontext;
+	struct fpstate_x86 __user *fp = sigframe_fp(frame);
+	int i, err = 0;
+
+	err |= __put_user(regs->user.r8, &sc->r8);
+	err |= __put_user(regs->user.r9, &sc->r9);
+	err |= __put_user(regs->user.r10, &sc->r10);
+	err |= __put_user(regs->user.r11, &sc->r11);
+	err |= __put_user(regs->user.r12, &sc->r12);
+	err |= __put_user(regs->user.r13, &sc->r13);
+	err |= __put_user(regs->user.r14, &sc->r14);
+	err |= __put_user(regs->user.r15, &sc->r15);
+	err |= __put_user(regs->user.rdi, &sc->rdi);
+	err |= __put_user(regs->user.rsi, &sc->rsi);
+	err |= __put_user(regs->user.rbp, &sc->rbp);
+	err |= __put_user(regs->user.rbx, &sc->rbx);
+	err |= __put_user(regs->user.rdx, &sc->rdx);
+	err |= __put_user(regs->user.rax, &sc->rax);
+	err |= __put_user(regs->user.rcx, &sc->rcx);
+	err |= __put_user(regs->user.rsp, &sc->rsp);
+	err |= __put_user(regs->user.rip, &sc->rip);
+	err |= __put_user(regs->user.eflags, &sc->eflags);
+	err |= __put_user((__u16)0x33, &sc->cs);
+	err |= __put_user((__u16)0x2b, &sc->ss);
+	err |= __put_user((__u64)0, &sc->err);
+	err |= __put_user((__u64)14, &sc->trapno);	/* page fault */
+	err |= __put_user((__u64)regs->badaddr, &sc->cr2);
+	err |= __put_user((__u64)fp, &sc->fpstate);
+	/* Kernel-private: the FS/GS bases, which sigcontext does not carry. */
+	err |= __put_user(regs->user.fs_base, &sc->reserved1[0]);
+	err |= __put_user(regs->user.gs_base, &sc->reserved1[1]);
+	err |= __copy_to_user(&frame->uc.uc_sigmask, set, sizeof(*set));
+
+	err |= __put_user(regs->user.fcw, &fp->cwd);
+	err |= __put_user(regs->user.fsw, &fp->swd);
+	err |= __put_user(regs->user.ftw, &fp->twd);
+	err |= __put_user(regs->user.fop, &fp->fop);
+	err |= __put_user((__u32)regs->user.mxcsr, &fp->mxcsr);
+	for (i = 0; i < 8; i++)
+		err |= __copy_to_user(&fp->st[i * 16], &regs->user.x87[i], 16);
+	for (i = 0; i < 16; i++)
+		err |= __copy_to_user(&fp->xmm[i * 16], &regs->user.xmm[i], 16);
+
+	return err ? -EFAULT : 0;
+}
+
+static int setup_rt_frame(struct ksignal *ksig, sigset_t *set,
+			  struct pt_regs *regs)
+{
+	struct rt_sigframe_x86 __user *frame;
+	void __user *fp;
+	unsigned long sp;
+	int err = 0;
+
+	/* x86-64 should always use SA_RESTORER. */
+	if (!(ksig->ka.sa.sa_flags & SA_RESTORER))
+		return -EFAULT;
+
+	/* get_sigframe(): the frame and its FXSAVE area, 16-byte aligned. */
+	sp = sigsp(regs->user.rsp, ksig);
+	sp = (sp - sizeof(struct rt_sigframe_x86) - sizeof(struct fpstate_x86)) & ~15UL;
+	frame = (struct rt_sigframe_x86 __user *)sp;
+	fp = sigframe_fp(frame);
+
+	if (!access_ok(frame, sizeof(struct rt_sigframe_x86) +
+		       sizeof(struct fpstate_x86) + 15))
+		return -EFAULT;
+
+	err |= __put_user(0UL, &frame->uc.uc_flags);
+	err |= __put_user((void __user *)0, &frame->uc.uc_link);
+	err |= __save_altstack(&frame->uc.uc_stack, regs->user.rsp);
+	err |= __put_user((char __user *)ksig->ka.sa.sa_restorer, &frame->pretcode);
+	err |= __put_user((__u64)fp, &frame->uc.uc_mcontext.fpstate);
+	err |= setup_sigframe(frame, regs, set);
+	if (ksig->ka.sa.sa_flags & SA_SIGINFO)
+		err |= copy_siginfo_to_user(&frame->info, &ksig->info);
+	if (err)
+		return -EFAULT;
+
+	regs->user.rdi = ksig->sig;
+	regs->user.rax = 0;
+	regs->user.rsi = (unsigned long)&frame->info;
+	regs->user.rdx = (unsigned long)&frame->uc;
+	regs->user.rip = (unsigned long)ksig->ka.sa.sa_handler;
+	regs->user.rsp = (unsigned long)frame;
+	regs->user.cs = 0x33;
+	regs->user.ss = 0x2b;
+	regs->user.eflags |= X86_EFLAGS_IF;
+	regs->user.eflags &= ~X86_EFLAGS_TF;
+
+	return 0;
+}
+
+static void handle_signal(struct ksignal *ksig, struct pt_regs *regs)
+{
+	sigset_t *oldset = sigmask_to_save();
+	int ret;
+
+	rseq_signal_deliver(ksig, regs);
+	ret = setup_rt_frame(ksig, oldset, regs);
+	signal_setup_done(ret, ksig, test_thread_flag(TIF_SINGLESTEP));
+}
+
+void arch_do_signal_or_restart(struct pt_regs *regs)
+{
+	unsigned long continue_addr = 0, restart_addr = 0;
+	int retval = 0;
+	struct ksignal ksig;
+	bool syscall = (regs->cause == PT_CAUSE_SYSCALL);
+
+	if (syscall) {
+		continue_addr = regs->user.rip;
+		restart_addr = continue_addr - 2;	/* SYSCALL */
+		retval = regs->user.rax;
+
+		regs->cause = PT_CAUSE_NONE;
+
+		switch (retval) {
+		case -ERESTARTNOHAND:
+		case -ERESTARTSYS:
+		case -ERESTARTNOINTR:
+		case -ERESTART_RESTARTBLOCK:
+			regs->user.rax = regs->orig_x0;
+			regs->user.rip = restart_addr;
+			break;
+		}
+	}
+
+	if (get_signal(&ksig)) {
+		if (regs->user.rip == restart_addr &&
+		    (retval == -ERESTARTNOHAND ||
+		     retval == -ERESTART_RESTARTBLOCK ||
+		     (retval == -ERESTARTSYS &&
+		      !(ksig.ka.sa.sa_flags & SA_RESTART)))) {
+			regs->user.rax = -EINTR;
+			regs->user.rip = continue_addr;
+		}
+
+		handle_signal(&ksig, regs);
+		return;
+	}
+
+	if (syscall && regs->user.rip == restart_addr &&
+	    retval == -ERESTART_RESTARTBLOCK) {
+		regs->user.rax = __NR_restart_syscall;
+		regs->user.rip = restart_addr;
+	}
+
+	restore_saved_sigmask();
+}
+
+static int __init init_signal_minsigstksz(void)
+{
+	signal_minsigstksz = sizeof(struct rt_sigframe_x86) +
+		sizeof(struct fpstate_x86) + 16;
+	return 0;
+}
+arch_initcall(init_signal_minsigstksz);
+
+#endif /* CONFIG_WASM_USER_X86_64 */
